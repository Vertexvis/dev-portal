{
  "name": "dev-portal",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "docusaurus build",
    "clean": "rm -rf .docusaurus build node_modules",
    "deploy": "docusaurus deploy",
    "format": "prettier --write './**/*.+(js|jsx|ts|tsx|json|yml|yaml|md|mdx|html|css)'",
    "lint": "eslint . --ext .js --config .eslintrc",
    "lint-staged": "yarn lint && yarn format",
    "postinstall": "husky install",
    "prepare": "husky install",
    "start": "docusaurus start",
    "version-docs": "docusaurus docs:version",
    "swizzle": "docusaurus swizzle",
    "serve": "docusaurus serve"
  },
  "dependencies": {
    "@algolia/client-search": "^4.12",
    "@docusaurus/core": "^2.0.0-beta.14",
    "@docusaurus/plugin-client-redirects": "^2.0.0-beta.14",
    "@docusaurus/preset-classic": "^2.0.0-beta.14",
    "classnames": "^2.3",
    "docusaurus-gtm-plugin": "^0.0.2",
    "mermaid": "10.9.8",
    "react": "^17.0",
    "react-dom": "^17.0",
    "react-hubspot-form": "^1.3.7",
    "swagger-ui": "^4",
    "swagger-ui-react": "^3"
  },
  "devDependencies": {
    "@types/react": "^17.0",
    "@vertexvis/eslint-config-vertexvis": "^0.7",
    "eslint": "^8.6",
    "eslint-plugin-react": "^7.28",
    "husky": "^7.0",
    "prettier": "^2.5",
    "raw-loader": "^4.0"
  },
  "workspaces": {
    "nohoist": [
      "**/html-minifier-terser"
    ]
  },
  "resolutions": {
    "**/gray-matter/js-yaml": "^3.15.1",
    "**/js-yaml": "^4.3.1",
    "**/@swagger-api/apidom-reference/**/minimatch": "^10.2.4",
    "**/minimatch": "^3.1.5",
    "**/wait-on/axios": "^0.34.0",
    "@babel/core": "7.29.6",
    "async": "^2.6.4",
    "cookie": "^0.7.2",
    "dompurify": "^3.4.17",
    "follow-redirects": "^1.16.3",
    "http-cache-semantics": "^4.1.1",
    "json5": "^2.2.3",
    "node-fetch": "^2.6.7",
    "node-forge": "^1.4.3",
    "prismjs": "^1.30.0",
    "serve-handler": "^6.1.8",
    "tmp": "^0.2.6",
    "trim": "^0.0.2",
    "ua-parser-js": "^0.7.33"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
